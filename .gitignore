# Per HISE project (projects/<Project>/):
# build output (tools/build_plugin.sh, HISE export)
/projects/*/Binaries/
# the scriptnode DLL project, generated by HISE compile_networks, and its DLL
/projects/*/DspNetworks/Binaries/
# written by the plugin export
/projects/*/AdditionalSourceCode/nodes/
/projects/*/PooledResources/
# encoded samples: generated from the WAVs (Sampler1.encodeAllMonoliths(), see the project's
# PROGRESS.md "Adding a sound"); encode them before building the plugin from a fresh checkout
/projects/*/Samples/*.ch1
# HISE autosaves
/projects/*/Presets/Autosave_*.hip

# Editor / tool state
/.idea/
/.claude/
*.user
