+void ScriptingApi::Sampler::encodeAllMonoliths()
+{
+#if USE_BACKEND
+	ModulatorSampler *s = static_cast<ModulatorSampler*>(sampler.get());
+
+	if (s == nullptr)
+	{
+		reportScriptError("encodeAllMonoliths() only works with Samplers.");
+		return;
+	}
+
+	WeakReference<Processor> safeSampler = s;
+
+	// Same as the "Encode all samplemaps" button, but silent and without the dialog.
+	MessageManager::callAsync([safeSampler]()
+	{
+		if (auto ms = dynamic_cast<ModulatorSampler*>(safeSampler.get()))
+		{
+			auto encoder = new BatchReencoder(ms);
+			encoder->setSilentMode(true);
+			encoder->setAdditionalFinishCallback([safeSampler]()
+			{
+				if (safeSampler != nullptr)
+					debugToConsole(safeSampler.get(), "encodeAllMonoliths() finished");
+			});
+			encoder->runThread();
+		}
+	});
+#endif
+}
