+// ShadowDSP (local patch): a panel with "All Callbacks" gets the mouse wheel as an event with
+// mouseWheel = true and wheelDeltaX / wheelDeltaY (JUCE's deltas); any other level passes it on as before
+void MouseCallbackComponent::mouseWheelMove(const MouseEvent& event, const MouseWheelDetails& wheel)
+{
+	if (callbackLevel < CallbackLevel::AllCallbacks)
+	{
+		Component::mouseWheelMove(event, wheel);
+		return;
+	}
+
+	static const Identifier mouseWheel("mouseWheel");
+	static const Identifier wheelDeltaX("wheelDeltaX");
+	static const Identifier wheelDeltaY("wheelDeltaY");
+
+	auto& info = clickInformation[(int)Action::MouseWheel];
+	fillMouseCallbackObject(info, this, event, callbackLevel, Action::MouseWheel, EnterState::Nothing);
+
+	if (auto e = info.getDynamicObject())
+	{
+		e->setProperty(mouseWheel, true);
+		e->setProperty(wheelDeltaX, wheel.deltaX);
+		e->setProperty(wheelDeltaY, wheel.isReversed ? -wheel.deltaY : wheel.deltaY);
+	}
+
+	sendToListeners(info);
+}
